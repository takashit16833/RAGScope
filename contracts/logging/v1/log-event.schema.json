{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAGScope Log Event v1",
  "description": "JSON representation of one RAGScope structured log record.",
  "type": "object",
  "required": [
    "timestamp",
    "component",
    "event",
    "level"
  ],
  "dependentRequired": {
    "trace_id": [
      "span_id"
    ],
    "span_id": [
      "trace_id"
    ]
  },
  "additionalProperties": false,
  "properties": {
    "timestamp": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "component": {
      "type": "string"
    },
    "event": {
      "$ref": "#/$defs/eventName"
    },
    "level": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
      ]
    },
    "message": {
      "type": "string"
    },
    "trace_id": {
      "$ref": "#/$defs/traceId"
    },
    "span_id": {
      "$ref": "#/$defs/spanId"
    },
    "attributes": {
      "$ref": "#/$defs/rootAttributes"
    }
  },
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]*[1-9])?Z$"
    },
    "eventName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "not": {
        "const": "00000000000000000000000000000000"
      }
    },
    "spanId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$",
      "not": {
        "const": "0000000000000000"
      }
    },
    "rootAttributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      }
    },
    "attributeObject": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/attributeValue"
      }
    },
    "attributeValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attributeValue"
          }
        },
        {
          "$ref": "#/$defs/attributeObject"
        }
      ]
    }
  }
}
