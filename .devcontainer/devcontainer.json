{
  "name": "RAGScope",
  "dockerComposeFile": "../compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/RAGScope/${localWorkspaceFolderBasename}/ragscope-app",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "2.55.0"
    }
  },
  "postCreateCommand": "bash /workspaces/RAGScope/${localWorkspaceFolderBasename}/.devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "settings": {
        // ragscope-app を VS Code のルートとして開いたまま、
        // 親ディレクトリにある RAGScope の Git worktree を検出する。
        "git.openRepositoryInParentFolders": "always",
        "haskell.manageHLS": "PATH",
        "haskell.formattingProvider": "fourmolu",
        "haskell.plugin.fourmolu.config.external": true,
        "haskell.cabalFormattingProvider": "cabal-gild",
        "[haskell]": {
          "editor.formatOnSave": true
        },
        "[cabal]": {
          "editor.detectIndentation": false,
          "editor.formatOnSave": true,
          "editor.insertSpaces": true,
          "editor.tabSize": 2
        },
        "[json][jsonc]": {
          "editor.defaultFormatter": "vscode.json-language-features",
          "editor.formatOnSave": true
        }
      },
      "extensions": [
        "haskell.haskell",
        "editorconfig.editorconfig",
        "redhat.vscode-yaml"
      ]
    }
  }
}