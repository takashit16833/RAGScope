cabal-version: 3.0
name: ragscope
version: 0.1.0.0
-- synopsis:
-- description:
license: NONE
author: takashit16833
maintainer: takashit16833@gmail.com
-- copyright:
build-type: Simple
extra-doc-files: CHANGELOG.md

-- extra-source-files:
common warnings
  ghc-options: -Wall

library
  import: warnings
  exposed-modules:
    RAGScope.Error.Types
    RAGScope.Logging.Types

  -- other-modules:
  -- other-extensions:
  build-depends:
    base ^>=4.21.2.0

  hs-source-dirs: src
  default-language: GHC2021

executable ragscope
  import: warnings
  main-is: Main.hs
  -- other-modules:
  -- other-extensions:
  build-depends:
    base ^>=4.21.2.0,
    ragscope,

  hs-source-dirs: app
  default-language: GHC2021

test-suite ragscope-test
  import: warnings
  default-language: GHC2021
  -- other-modules:
  -- other-extensions:
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    base ^>=4.21.2.0,
    ragscope,
